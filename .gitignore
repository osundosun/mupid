# root (husky) dependencies
/node_modules
/.gradle-ci/
/.release/

# python
__pycache__/
*.py[cod]
.venv/

# music_preprocessing (uv)
/music_preprocessing/config.json
# 배치 계정의 리프레시 토큰. 커밋하면 시스템 권한이 그대로 새어 나간다.
/music_chunking/refresh_token.txt
/music_chunking/registered.json
/music_chunking/processed.json
/music_chunking/input/
/music_chunking/output/

# infra_k8s 노드 접속 정보 (.env.example 를 복사해 만든 것)
/infra_k8s/.env

# 환경 변수 실제 값. 예시 파일(.env.example)만 커밋한다.
# infra/deploy/.env 는 실제로 작업 트리에 있으면서 무시되지 않아, 루트에서 `git add -A`
# 한 번이면 배포 자격 증명이 그대로 올라가는 상태였다.
.env
.env.*
!.env.example
!*.env.example

/music_preprocessing/refresh_token.txt
/music_preprocessing/registered.json
/music_preprocessing/processed.json
/music_preprocessing/input/
/music_preprocessing/output/
# 실행마다 파일 하나가 생기는 배치 로그
/music_preprocessing/logs/
