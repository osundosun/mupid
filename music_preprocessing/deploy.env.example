# JupyterHub 배포에 쓰는 값들. **이 파일을 그대로 커밋하지 말고**, 값을 채운
# 사본을 GitLab CI/CD 변수 `MUPID_DATA_ENV` 에 넣는다.
#
#   Settings → CI/CD → Variables → Add variable
#     Key    MUPID_DATA_ENV
#     Value  (이 파일을 채운 내용 전체를 붙여 넣는다)
#     Type   File          ← Variable 이 아니라 File 이다
#     Flags  Protected     ← 보호 브랜치에서만 주어진다
#
# **File 형식이어야 한다.** 환경에 들어가는 것이 내용이 아니라 경로라서
# `echo $MUPID_DATA_ENV` 를 해도 경로만 나온다. 마스킹이 필요 없고, 비밀번호가
# 8자 미만이라 GitLab 이 마스킹을 거부하는 문제도 비껴간다. 이 저장소는 배포용
# SSH 개인키를 이미 같은 형식으로 넣고 있다.
#
# `#` 로 시작하는 줄과 빈 줄은 무시한다. 값의 따옴표는 벗겨 낸다.
# 같은 이름이 두 번 있으면 배포가 멈춘다 — 어느 쪽이 이겼는지 모르는 것보다 낫다.

# ── 배포 대상 ────────────────────────────────────────────────────────────
JUPYTER_BASE_URL=https://lab.tailf237b8.ts.net
JUPYTER_USER=
JUPYTER_PASSWORD=
# 홈 기준 상대 경로. 생략하면 music_preprocessing 이다.
#JUPYTER_DIR=music_preprocessing

# ── 배치 설정 ────────────────────────────────────────────────────────────
# 이름은 config.example.json 의 필드를 대문자로 쓴 것이다. 여기 적지 않은
# 필드는 config.example.json 의 값이 그대로 간다 — 기본값은 저장소에 두어
# 리뷰와 이력이 남게 하고, 환경마다 다른 것만 여기 적는다.
#
# 모르는 이름을 적으면 배포가 멈추고 쓸 수 있는 이름을 전부 알려 준다.
# 오타를 조용히 넘기면 그 설정은 영영 반영되지 않는다.

# 비우면 청킹만 하고 API 등록은 건너뛴다.
API_BASE_URL=https://j15a204.p.ssafy.io
# 처리할 음원이 있는 곳. 기본값(./input)은 거의 항상 틀리다.
INPUT_DIR=
METADATA_DIR=
COVERS_DIR=

# 숫자 자리에 숫자가 아닌 것을 적으면 배포가 멈춘다. 서버의 ChunkConfig 는
# 문자열 "6" 도 받아 주고 ffmpeg 인자를 만들 때 가서야 깨지기 때문이다.
#SEGMENT_TIME=6
#BITRATE=128k
#MAX_WORKERS=0

# ── 비밀 ─────────────────────────────────────────────────────────────────
# ROLE_SYSTEM 계정의 리프레시 토큰. 서버에 refresh_token.txt 가 없을 때만
# 쓰인다 — **배치가 이 파일을 회전시키므로**, 배포할 때마다 여기 적힌 초기
# 토큰으로 되돌리면 이미 무효가 된 값을 도로 넣는 셈이라 다음 배치가 인증에
# 실패한다.
REFRESH_TOKEN=

# 서버의 토큰을 일부러 갈아엎을 때만 true 로 둔다. 갈아엎은 뒤에는 다시
# false 로 되돌린다 — 켜 둔 채로 두면 매 배포가 토큰을 되감는다.
RESET_TOKEN=false
