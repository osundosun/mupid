# 노드 접속 정보. 이 파일을 복사해 실제 값을 채운다.
#   cp infra_k8s/.env.example infra_k8s/.env
#
# 값은 여기에 적지 않는다. 이 파일은 키 목록과 각 키의 의미만 갖는다.
# 비밀값은 .env 에도 두지 않는다 — 클러스터 Secret 은 서버에서 따로 만든다
# (base/kustomization.yaml 의 --from-env-file 주석 참고).

# 주소가 두 종류인 이유
#   PUBLIC    바깥에서 SSH 로 접속할 때 쓰는 주소. CONTROLLER 나 워크스테이션이 쓴다.
#   PRIVATE   NODE_A 와 NODE_B 가 서로를 부를 때 쓰는 VPC 사설 주소. k3s 가
#             광고하는 주소가 이것이어야 한다. 공인 주소를 광고하면 6443 이
#             인터넷에 열린다. ClickHouse interserver 와 SeaweedFS 볼륨 서버가
#             서로를 부르는 주소도 이쪽이다.
# ansible/inventory.ini 의 ansible_host / k3s_node_ip 와 같은 구분이고,
# 무너지면 API 서버가 인터넷에 노출된다.

# SSH_KEY 는 *접속하는 쪽 기계의* 경로다. CONTROLLER 에서 돌릴 때와
# 워크스테이션에서 돌릴 때 값이 다르다.

# 호스트 키 지문 대조는 ansible/CONTROL-NODE.md 에 있다. TOFU 로 받아 두지 않는다.

# 주의: ansible/inventory.ini 는 아직 이 값들을 하드코딩하고 있고 이 파일을 읽지
# 않는다. .env 만 고쳐서는 플레이북 동작이 바뀌지 않는다.


# --- CONTROLLER · 라즈베리파이 -----------------------------------------------
# 역할: Ansible 제어 노드. GitLab Runner 와 이미지 빌드를 여기로 옮기는 중.
# 클러스터 멤버가 아니다 — k3s 는 NODE_A·NODE_B 에만 올라간다.
#
# aarch64 다. EC2 는 x86_64 라 여기서 그냥 만든 이미지는 노드에서 돌지 않는다.
# Tailscale 뒤에 있어 공인 주소가 없다 — PUBLIC 에 tailnet 주소를 넣는다.
# EC2 사설 대역(172.26.0.0/16)에는 닿지 않으므로 PRIVATE 는 채울 값이 없다.
MUPID_CONTROLLER_HOST_PUBLIC=
MUPID_CONTROLLER_HOST_PRIVATE=
MUPID_CONTROLLER_SSH_USER=
MUPID_CONTROLLER_SSH_KEY=

# --- NODE_A (k3s server) -----------------------------------------------------
# inventory.ini 의 node-a. 엣지를 겸한다 — 80/443 을 여기서 받는다.
# 단독 워크로드: edge · api(Spring) · mysql · redis · SeaweedFS master/filer/s3
# 양쪽 공통:     ClickHouse · SeaweedFS 볼륨 서버
MUPID_NODE_A_HOST_PUBLIC=
MUPID_NODE_A_HOST_PRIVATE=
MUPID_NODE_A_SSH_USER=
MUPID_NODE_A_SSH_KEY=

# --- NODE_B (k3s agent) ------------------------------------------------------
# inventory.ini 의 node-b.
# 단독 워크로드: ai_server (개발 중, 1차 전환 범위 밖)
# 양쪽 공통:     ClickHouse · SeaweedFS 볼륨 서버
MUPID_NODE_B_HOST_PUBLIC=
MUPID_NODE_B_HOST_PRIVATE=
MUPID_NODE_B_SSH_USER=
MUPID_NODE_B_SSH_KEY=
