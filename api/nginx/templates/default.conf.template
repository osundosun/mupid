# ${API_UPSTREAM} 는 컨테이너 기동 시 envsubst 로 치환된다.
#   - 운영(compose.yml)     : api:8800
#   - 개발(compose.dev.yml) : host.docker.internal:8800  (호스트에서 직접 띄운 스프링)
upstream mupid_api {
    server ${API_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    # nginx 자체 헬스체크 (백엔드와 무관하게 200)
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # 스프링이 내려준 X-Accel-Redirect 를 받아 오브젝트 스토리지(SeaweedFS filer)에서
    # 실제 청크 바이트를 읽어 클라이언트에 보낸다. internal 이라 외부에서 직접 못 친다.
    location /storage/ {
        internal;
        proxy_pass http://${STORAGE_UPSTREAM}/;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # 원 요청의 Authorization 이 스토리지로 새지 않도록 지운다.
        proxy_set_header Authorization "";

        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://mupid_api;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # SSE / 스트리밍 응답 대비
        proxy_buffering off;
    }
}
