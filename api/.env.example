# 서버 포트
MUPID_PORT=8800
MUPID_NGINX_PORT=8080

# MySQL 연결
MUPID_MYSQL_PORT=13306
MUPID_MYSQL_URL=
MUPID_MYSQL_USER=
MUPID_MYSQL_PASSWORD=

# Redis 연결
MUPID_REDIS_HOST=
MUPID_REDIS_PORT=16379
MUPID_REDIS_KEY_PREFIX=  # 캐시 키 접두사 (예: mupid:dev)

# 업로드 상한 (비우면 각각 20MB)
MUPID_MAX_UPLOAD_FILE_SIZE=
MUPID_MAX_UPLOAD_REQUEST_SIZE=

# JWT secret key
MUPID_JWT_SECRET=  # openssl rand -base64 32

# Gmail API
MUPID_GMAIL_CLIENT_ID=  # Google Cloud Dashboard
MUPID_GMAIL_CLIENT_SECRET=  # Google Cloud Dashboard
MUPID_GMAIL_TOKEN=  # https://developers.google.com/oauthplayground
MUPID_GMAIL_SEND_ADDRESS=  # someone@gmail.com

# S3 연결
MUPID_S3_ENDPOINT=  # 개발은 SeaweedFS (http://localhost:8333), 운영은 빈 값
MUPID_S3_ACCESS_KEY=
MUPID_S3_SECRET=  # openssl rand -hex 32
MUPID_S3_BUCKET=

# 공식 클라이언트
MUPID_CLIENT_WEBSITE=

# AI 대화 (OpenAI 호환 게이트웨이)
# 키가 비어 있으면 /api/v1/ai/chat 이 503 을 낸다.
MUPID_AI_GMS_KEY=  # https://gms.ssafy.io 에서 발급 (예전 이름 MUPID_AI_GMS 도 받는다)
# 비우면 각각 https://gms.ssafy.io/gmsapi/api.openai.com/v1 · gpt-5-mini 로 돌아간다.
MUPID_AI_BASE_URL=
MUPID_AI_MODEL=

# ClickHouse 연결
# .env 는 Spring 이 .properties 로도 읽는다(spring.config.import). properties 문법에서는
# 줄 끝 주석이 값에 포함되므로, 실제 값이 있는 항목은 주석을 위 줄에 둔다.
MUPID_CLICKHOUSE_VERSION=25.3
# 노드별 ClickHouse 메모리 상한(바이트). 0 이면 호스트 RAM 비율 자동 계산.
# 로컬은 한 머신에 노드 2개 + MySQL/Redis/Kafka 가 같이 도니 묶어둔다.
MUPID_CLICKHOUSE_MAX_MEMORY=4294967296
# ch-01 HTTP. Spring 이 붙는 포트다.
MUPID_CLICKHOUSE_HTTP_PORT=18123
MUPID_CLICKHOUSE_NATIVE_PORT=19000
# ch-02 (샤드 2). 직접 조회나 디버깅용.
MUPID_CLICKHOUSE_HTTP_PORT_2=18124
MUPID_CLICKHOUSE_NATIVE_PORT_2=19001
MUPID_CLICKHOUSE_URL=jdbc:clickhouse://localhost:18123/default
# 관리자 콘솔이 프록시할 ClickHouse HTTP 주소. 비우면 위 JDBC 주소에서 만들어 쓴다.
# ch-02 를 들여다보고 싶을 때만 http://localhost:18124 처럼 채운다.
MUPID_CLICKHOUSE_HTTP_URL=
MUPID_CLICKHOUSE_USER=mupid
MUPID_CLICKHOUSE_PASSWORD=

# Kafka 연결 (Spring 이 발행하고 ClickHouse Kafka 엔진이 소비하는 파이프라인)
MUPID_KAFKA_VERSION=3.9.1
MUPID_KAFKA_PORT=19092
# KRaft 클러스터 ID. 16바이트를 base64 로 인코딩한 22글자.
MUPID_KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
# Spring 수집기가 발행하는 토픽. ClickHouse kafka_listen_events 와 같아야 한다.
MUPID_KAFKA_TOPIC=mupid.listen.events
# Spring 프로듀서의 부트스트랩 주소. 컨테이너 안에서 돌리면 kafka1:9092 로 바꾼다.
MUPID_KAFKA_BOOTSTRAP=localhost:19092
