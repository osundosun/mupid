# 서버 포트
MUPID_PORT=8800
MUPID_NGINX_PORT=8080

# MySQL 연결
MUPID_MYSQL_PORT=13306
MUPID_MYSQL_URL=
MUPID_MYSQL_USER=
MUPID_MYSQL_PASSWORD=

# Redis 연결
MUPID_REDIS_HOST=
MUPID_REDIS_PORT=16379
MUPID_REDIS_KEY_PREFIX=  # 캐시 키 접두사 (예: mupid:dev)

# JWT secret key
MUPID_JWT_SECRET=  # openssl rand -base64 32

# Gmail API
MUPID_GMAIL_CLIENT_ID=  # Google Cloud Dashboard
MUPID_GMAIL_CLIENT_SECRET=  # Google Cloud Dashboard
MUPID_GMAIL_TOKEN=  # https://developers.google.com/oauthplayground

# S3 연결
MUPID_S3_ENDPOINT=  # 개발은 SeaweedFS (http://localhost:8333), 운영은 빈 값
MUPID_S3_ACCESS_KEY=
MUPID_S3_SECRET=  # openssl rand -hex 32
MUPID_S3_BUCKET=
