# Actual secrets exist only in /srv/mupid/.env on the application server.
MUPID_HTTP_PORT=80
MUPID_HTTPS_PORT=443
MUPID_MYSQL_ROOT_PASSWORD=
MUPID_MYSQL_USER=
MUPID_MYSQL_PASSWORD=
MUPID_JWT_SECRET=
# Required by the current backend. Fill these on the server before installing the new Compose.
MUPID_REDIS_KEY_PREFIX=mupid:prod
MUPID_GMAIL_CLIENT_ID=
MUPID_GMAIL_CLIENT_SECRET=
MUPID_GMAIL_TOKEN=
MUPID_GMAIL_SEND_ADDRESS=
# Empty is allowed, but AWS use also requires a backend region configuration review.
# A development localhost endpoint is not reachable from the API container as host localhost.
MUPID_S3_ENDPOINT=
MUPID_S3_ACCESS_KEY=
MUPID_S3_SECRET=
MUPID_S3_BUCKET=
MUPID_CLIENT_WEBSITE=https://j15a204.p.ssafy.io
# Set by the release deployment process.
MUPID_API_IMAGE=
