# Actual secrets exist only in /srv/mupid/.env on the application server.
MUPID_HTTP_PORT=80
MUPID_HTTPS_PORT=443
MUPID_MYSQL_ROOT_PASSWORD=
MUPID_MYSQL_USER=
MUPID_MYSQL_PASSWORD=
MUPID_JWT_SECRET=
# Required by the current backend. Fill these on the server before installing the new Compose.
MUPID_REDIS_KEY_PREFIX=mupid:prod
MUPID_GMAIL_CLIENT_ID=
MUPID_GMAIL_CLIENT_SECRET=
MUPID_GMAIL_TOKEN=
MUPID_GMAIL_SEND_ADDRESS=
# Empty is allowed, but AWS use also requires a backend region configuration review.
# A development localhost endpoint is not reachable from the API container as host localhost.
MUPID_S3_ENDPOINT=
MUPID_S3_ACCESS_KEY=
MUPID_S3_SECRET=
MUPID_S3_BUCKET=
MUPID_CLIENT_WEBSITE=https://j15a204.p.ssafy.io
# Set by the release deployment process.
MUPID_API_IMAGE=

# --- 분석 스택 (ClickHouse / Kafka) ----------------------------------------
# 서버마다 다른 값
#   서버 A: COMPOSE_PROFILES=analytics,keeper  CH_SHARD=01  CH_REPLICA=ch1
#   서버 B: COMPOSE_PROFILES=analytics,kafka   CH_SHARD=02  CH_REPLICA=ch2
COMPOSE_PROFILES=
CH_SHARD=
CH_REPLICA=
# 이 서버의 주소 (상대 노드가 파트를 가져올 때 접속한다)
CH_INTERSERVER_HOST=
# 두 서버 모두 같은 값. 컨테이너 이름이 아니라 실제 주소여야 한다.
CH_HOST_1=
CH_HOST_2=
CH_KEEPER_HOST=
# 0 이면 ClickHouse 가 자동 계산. mem_limit 를 걸었으므로 보통 0.
CH_MAX_SERVER_MEMORY=0
MUPID_CLICKHOUSE_MEM_LIMIT=4g
MUPID_CLICKHOUSE_VERSION=25.3
MUPID_CLICKHOUSE_USER=mupid
MUPID_CLICKHOUSE_PASSWORD=
# Kafka 가 뜬 서버의 주소. ClickHouse 가 kafka1/kafka2 를 이 주소로 해석한다.
MUPID_KAFKA_HOST=
MUPID_KAFKA_VERSION=3.9.1
MUPID_KAFKA_MEM_LIMIT=2g
MUPID_KAFKA_TOPIC=mupid.listen.events
# KRaft 클러스터 ID. 16바이트를 base64 로 인코딩한 22글자.
MUPID_KAFKA_CLUSTER_ID=
# 상대 서버 IP 에만 열 것. 인터넷 노출 금지.
MUPID_CLICKHOUSE_NATIVE_BIND=9000
MUPID_CLICKHOUSE_INTERSERVER_BIND=9009
MUPID_KEEPER_BIND=9181
MUPID_KAFKA_BIND=9092
# 앱이 붙는 주소 (같은 호스트의 컨테이너 네트워크 안)
MUPID_CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/default
