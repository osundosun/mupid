# AI 추천 서비스 환경변수. 실제 값은 여기에 쓰지 말고 .env 또는 배포 환경에 넣는다.

# 모델·색인 루트. 아래에 data/proc/mupid/... 구조가 그대로 있어야 한다.
MUPID_AI_ARTIFACT_DIR=./artifacts
# 서비스 포트.
MUPID_AI_PORT=8100
# 숫자 ID 매핑표. 비우면 <ARTIFACT_DIR>/data/proc/mupid/id_map.parquet 을 쓴다.
MUPID_ID_MAP=
# 자연어 해석기 주소. 비우면 /internal/recommendations/search 가 501 을 돌려준다.
# 자연어 기능 확장은 S15P21A204-219 범위다.
MUPID_AI_NLP_URL=
