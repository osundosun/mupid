# AI 추천 서비스 환경변수. 실제 값은 여기에 쓰지 말고 .env 또는 배포 환경에 넣는다.

# --- 필수 ---------------------------------------------------------------
# 모델·색인 루트. 아래에 data/proc/mupid/... 구조가 그대로 있어야 한다.
# 서비스·매핑표·라벨러가 모두 이 하나를 기준으로 경로를 만든다.
MUPID_AI_ARTIFACT_DIR=

# 곡·순간 메타데이터의 정본은 **MySQL** 이다. 추천 서버는 Spring 을 부르지 않는다 —
# Spring 이 추천 요청 본문(`catalog`)에 후보와 그 값을 싣는다(연동 계약 2026-09-23 절).
# 그래서 서버에는 Spring 주소도 토큰도 필요 없다.

# --- 선택 ---------------------------------------------------------------
# 서비스 포트.
MUPID_AI_PORT=8100

# 배치가 **쓰는** 자리. 색인과 나눈다.
# 색인(`MUPID_AI_ARTIFACT_DIR`)은 여러 파드가 함께 읽는 것이라 마운트가 읽기 전용이다.
# 그런데 라벨러는 이벤트 로그·라벨·선호 순간을 써야 한다 — 비우면 색인 자리로
# 떨어지고, 거기는 읽기 전용이라 **배치가 통째로 실패한다.**
# 운영 매니페스트(`ai.yaml`·`ai-labeler.yaml`)는 둘 다 `/state` 를 준다.
MUPID_AI_STATE_DIR=

# 숫자 ID 매핑표. **시험용 매핑표를 따로 물릴 때만** 쓴다.
# 서빙과 배치는 이 파일을 보지 않는다 — 배치의 숫자 환산 근거는 ClickHouse
# `v_track_sections_current` 다(`app/track_sections.py`).
MUPID_ID_MAP=


# --- 행동 데이터 (개인화) -----------------------------------------------
# 요청마다 직접 조회한다. 비우면 서비스는 뜨지만 **모든 추천이 콜드스타트**다.
# 로컬 개발 스택은 api/compose.yml 의 ClickHouse 를 그대로 쓰면 된다.
# `jdbc:clickhouse://host:port/db` 형태도 받는다.
MUPID_CLICKHOUSE_URL=
MUPID_CLICKHOUSE_USER=
MUPID_CLICKHOUSE_PASSWORD=
# jdbc 형태는 스킴 정보가 없다. TLS 라면 1 로 표시한다 — 표시하지 않으면 평문으로 붙는다.
MUPID_CLICKHOUSE_SECURE=

# --- 추천 대상·모델을 바꾸는 값 (기본값 그대로 두는 것을 권장) -----------
# 후보 풀의 주 출처. moments.parquet 의 source 값이다.
MUPID_POOL=flow
# 주 출처에 **더해** 후보로 넣을 출처. 쉼표로 구분한다.
# **비워 둔다.** jamendo 는 실서비스에서 재생되지 않는 곡이라 추천에 섞이면 사용자가
# 누를 수 없는 결과가 나간다 — 오류가 아니라 '재생이 안 되는 추천' 이라 화면만 보고는
# 무엇이 잘못됐는지 알기 어렵다. 배포 직후 받은 추천 3건이 전부 JAMENDO_* 였던 적이
# 있고(`infra_k8s/base/ai.yaml`), 그 뒤로 운영은 빈 값으로 덮고 있다.
# 색인에서도 그 행을 뺐으므로 지금은 켜도 0건이다.
# 설정했는데 0건이면 기동 로그와 /health 의 catalog.empty_sources 에 나온다.
MUPID_POOL_EXTRA=
# 점수 결합기 파일 이름. <ARTIFACT_DIR>/data/proc/mupid/ 아래에서 찾는다.
# 바꾸면 추천 순위가 바뀐다. 색인과 짝이 맞는 파일이어야 한다.
MUPID_COMBINER=logistic_flow_stage1.json

# /internal 내부 호출 보호. 비우면 검사하지 않는다(현행).
# 값을 넣으면 Spring 이 X-Internal-Token 헤더로 같은 값을 보내야 한다 — **양쪽을 동시에**
# 설정해야 한다. 한쪽만 켜면 추천이 통째로 401 이 된다. /health 는 이 검사 밖이다.
MUPID_AI_INTERNAL_TOKEN=

# --- 순간 벡터 검색 (Pinecone) -------------------------------------------
# 벡터 검색과 fetch 만 Pinecone 이 한다. 곡·순간 메타데이터는 위의 카탈로그 API 가
# 정본이다. Pinecone 은 물리 인덱스 하나를 쓴다.
#
# 데이터 namespace에는 u = normalize(Z - mu)와 r = ||Z - mu||를,
# control namespace(<namespace>__control)에는 평균 mu·snapshot·state를 둔다.
# 원본 Z는 mu + r * u로 복원한다. raw/candidate 이중 인덱스는 쓰지 않는다.
MUPID_PINECONE_API_KEY=
MUPID_PINECONE_INDEX=mupid-moments
# 환경 + 승인된 임베딩 버전. **고정값이다** — 무중단 전환용으로 바꾸지 않는다.
# 평균·상태는 이 이름에 __control 을 붙인 namespace 에 둔다.
MUPID_PINECONE_NAMESPACE=prod__mert-v1-95m

# 검색 경로를 Pinecone 으로 돌릴지. **기본은 꺼짐.**
# 켜는 것은 초기 적재와 대사가 끝난 뒤의 별도 동작이어야 한다 — 키만 넣으면 켜지는
# 구조로 두면 아직 비어 있는 인덱스로 검색이 나가 모든 요청이 0건이 된다.
# 켠 상태에서 Pinecone 이 실패하면 **로컬 벡터로 내려가지 않고** 오류를 낸다.
MUPID_PINECONE_ENABLED=false

# 호출 하나의 제한 시간(초). 비우면 10.
MUPID_PINECONE_TIMEOUT=

# 갱신 배치가 "AI 서버가 새 평균을 읽었는가" 를 확인할 주소.
# 확인하지 못하면 control 을 READY 로 바꾸지 않는다 — 확인하지 않은 것을
# 확인했다고 하지 않기 위해서다. 클러스터 안이면 http://ai:8100
MUPID_AI_SERVER_URL=

# 분석 배치 호스트의 ai_server 체크아웃 경로. run_batch.sh 가 여기서 동기화를
# 돌린다. 구현을 music_preprocessing 으로 복사하지 않는다.
MUPID_AI_SERVER_DIR=

# --- 적재 도구 (추천 서버는 쓰지 않는다) ---------------------------------
# `tools/register_sections` 처럼 **MySQL 에 쓰는** 도구만 Spring 을 부른다. MySQL 에
# 쓰는 길은 Spring 하나라는 계약이다. 추천 서버 파드에는 넣지 않는다.
MUPID_API_BASE_URL=
MUPID_API_REFRESH_TOKEN=
