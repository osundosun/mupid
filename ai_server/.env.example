# AI 추천 서비스 환경변수. 실제 값은 여기에 쓰지 말고 .env 또는 배포 환경에 넣는다.

# --- 필수 ---------------------------------------------------------------
# 모델·색인 루트. 아래에 data/proc/mupid/... 구조가 그대로 있어야 한다.
# 서비스·매핑표·라벨러가 모두 이 하나를 기준으로 경로를 만든다.
MUPID_AI_ARTIFACT_DIR=

# 곡·순간 메타데이터의 정본은 **MySQL** 이다. 색인에는 없다. AI 는 DB 에 직접 붙지
# 않고 Spring 내부 카탈로그 API 로만 읽는다
# (GET /api/v1/internal/ai/catalog, ROLE_SYSTEM 전용).
#
# 둘 다 채워야 한다. 비우면 **준비 완료로 올라오지 않는다** — 없이 뜨면 장르·무드·
# 보컬·악기 조건이 통째로 빈 채 추천이 나가고, 그것은 "조건에 맞는 곡이 없다" 로만
# 보여 정상과 구분되지 않는다.
#
# 적재 도구(`register_sections`·`register_analysis`)가 쓰는 값과 **같은 값**이다.
MUPID_API_BASE_URL=
MUPID_API_REFRESH_TOKEN=

# --- 선택 ---------------------------------------------------------------
# 서비스 포트.
MUPID_AI_PORT=8100

# --- 카탈로그 (곡·순간 메타데이터) ---------------------------------------
# 한 번에 받을 곡 수. Spring 쪽 상한이 500 이다.
MUPID_AI_CATALOG_PAGE_SIZE=200

# 이 시간(초)이 지나면 카탈로그를 다시 읽는다. **기본은 꺼져 있다(빈 값 = 0).**
# 켜는 쪽이 값을 넣는 쪽이 되게 한다 — 기본으로 도는 주기 호출은 설정한 기억 없이
# 생긴다. 꺼 두어도 `POST /internal/catalog/refresh` 로 언제든 갱신할 수 있고,
# 그쪽이 재기동 없이 반영하는 정규 경로다.
MUPID_AI_CATALOG_TTL_SEC=

# 카탈로그 호출 하나의 제한 시간(초). 비우면 15다.
MUPID_AI_CATALOG_TIMEOUT=

# 색인 구간이 카탈로그에 이만큼은 있어야 기동한다 (0~1, 비우면 0.5).
# 지워진 곡 때문에 일부가 비는 것은 정상이라 막지 않고 수만 남긴다. 절반을 넘게
# 어긋나면 판이 잘못 올라갔다고 보고 막는다 — 합법적인 삭제가 한 번에 절반을
# 넘는 일은 없다.
MUPID_AI_CATALOG_MIN_COVERAGE=

# 숫자 ID 매핑표. **시험용 매핑표를 따로 물릴 때만** 쓴다.
# 서빙과 배치는 이 파일을 보지 않는다 — 숫자 환산 근거는 위의 카탈로그 API 다.
MUPID_ID_MAP=

# 자연어 해석기(QueryPlan v1) 주소. 비우면 /internal/recommendations/search 가 501 이다.
# 설정 여부 판단과 실제 호출이 이 변수 하나를 본다.
# 해석기가 응답하지 않으면 조건을 무시한 추천을 내보내지 않고 500 으로 실패한다.
# 자연어 기능 확장은 S15P21A204-219 범위다.
MUPID_AI_NLP_URL=

# --- 행동 데이터 (개인화) -----------------------------------------------
# 요청마다 직접 조회한다. 비우면 서비스는 뜨지만 **모든 추천이 콜드스타트**다.
# 로컬 개발 스택은 api/compose.yml 의 ClickHouse 를 그대로 쓰면 된다.
# `jdbc:clickhouse://host:port/db` 형태도 받는다.
MUPID_CLICKHOUSE_URL=
MUPID_CLICKHOUSE_USER=
MUPID_CLICKHOUSE_PASSWORD=
# jdbc 형태는 스킴 정보가 없다. TLS 라면 1 로 표시한다 — 표시하지 않으면 평문으로 붙는다.
MUPID_CLICKHOUSE_SECURE=

# --- 추천 대상·모델을 바꾸는 값 (기본값 그대로 두는 것을 권장) -----------
# 후보 풀의 주 출처. moments.parquet 의 source 값이다.
MUPID_POOL=flow
# 주 출처에 **더해** 후보로 넣을 출처. 쉼표로 구분한다.
# 해당 출처의 행이 없으면 아무 영향이 없다. 비우면 주 출처만 쓴다.
# `own`(자체 음원)은 현재 카탈로그에 행이 0건이라 기본값에서 뺐다. 실제로 넣을 때 켠다.
# 설정했는데 0건이면 기동 로그와 /health 의 catalog.empty_sources 에 나온다.
MUPID_POOL_EXTRA=jamendo
# 점수 결합기 파일 이름. <ARTIFACT_DIR>/data/proc/mupid/ 아래에서 찾는다.
# 바꾸면 추천 순위가 바뀐다. 색인과 짝이 맞는 파일이어야 한다.
MUPID_COMBINER=logistic_flow_stage1.json

# /internal 내부 호출 보호. 비우면 검사하지 않는다(현행).
# 값을 넣으면 Spring 이 X-Internal-Token 헤더로 같은 값을 보내야 한다 — **양쪽을 동시에**
# 설정해야 한다. 한쪽만 켜면 추천이 통째로 401 이 된다. /health 는 이 검사 밖이다.
MUPID_AI_INTERNAL_TOKEN=
