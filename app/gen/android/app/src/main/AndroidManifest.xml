<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      상단 알림·잠금화면 플레이어. 재생 중에는 전경 서비스가 붙어 있어야 앱이
      뒤로 갔을 때 시스템이 프로세스를 정리하지 않는다 — 소리를 내는 것은
      웹뷰라 안드로이드는 그 사실을 따로 알지 못한다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      앱 스스로 APK 를 설치하려면 필요하다 (Android 8+). 이 권한이 있어도
      **사용자가 "이 출처의 앱 설치" 를 허용해야** 실제로 설치된다 —
      앱이 조용히 제 패키지를 갈아 끼울 수는 없다.

      이 선언이 없으면 인텐트를 띄우는 순간 SecurityException 으로 죽는다.
      증상이 "업데이트 버튼을 누르면 앱이 꺼진다" 라서 원인을 찾기 어렵다.
      그래서 여기 남긴다: `AppUpdatePlugin.kt` 가 이 권한을 전제로 짜여 있다.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.mupid_app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          알림을 들고 있는 전경 서비스. `MEDIA_BUTTON` 필터가 있어야 이어폰·
          블루투스 버튼과 알림 버튼의 PendingIntent 가 이리로 온다.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
