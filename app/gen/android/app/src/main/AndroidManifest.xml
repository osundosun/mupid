<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      상단 알림·잠금화면 플레이어. 재생 중에는 전경 서비스가 붙어 있어야 앱이
      뒤로 갔을 때 시스템이 프로세스를 정리하지 않는다 — 소리를 내는 것은
      웹뷰라 안드로이드는 그 사실을 따로 알지 못한다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      앱 스스로 APK 를 설치하려면 필요하다 (Android 8+). 이 권한이 있어도
      **사용자가 "이 출처의 앱 설치" 를 허용해야** 실제로 설치된다 —
      앱이 조용히 제 패키지를 갈아 끼울 수는 없다.

      이 선언이 없으면 인텐트를 띄우는 순간 SecurityException 으로 죽는다.
      증상이 "업데이트 버튼을 누르면 앱이 꺼진다" 라서 원인을 찾기 어렵다.
      그래서 여기 남긴다: `AppUpdatePlugin.kt` 가 이 권한을 전제로 짜여 있다.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.mupid_app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
          화상 키보드가 입력란을 가리던 문제 (S15P21A204-389).

          이 선언이 없으면 안드로이드의 기본값은 `adjustUnspecified` 다. 그 값이면
          시스템이 창 크기를 줄일지 화면을 밀어 올릴지 스스로 정하는데, 실제로는
          **줄이지 않고 키보드를 위에 덮었다** — 로그인·회원가입 대화상자의 아래쪽
          입력란(비밀번호 확인·출생 연도)이 키보드 뒤로 들어가 보이지 않았다.

          `adjustResize` 는 키보드 높이만큼 창(과 그 안의 웹뷰)을 줄이고, 그 몫을
          인셋으로 넘긴다. 줄어든 것을 아는 순간의 처리는 두 갈래다.

          - 화면 쪽: `layout.tsx` 의 `interactiveWidget: 'overlays-content'` 와
            `useKeyboardInset` 이 `visualViewport` 로 잰 가림 높이
            (CSS 변수 `keyboard-inset`) — 대화상자가 그만큼 짧아진다.
          - 네이티브 쪽: `SafeArea.install` 의 인셋 리스너가 같은 순간 울리고,
            CSS 변수 `safe-area-inset-*` 로 건너간다.

          **`adjustPan` 을 쓰면 안 된다.** 화면을 통째로 밀어 올리는 방식이라
          시스템 바 여백(`safe-area-inset-top`)과 어긋나고 스크롤 컨테이너 기준이
          흔들린다.

          주의: 이 주석 안에는 붙임표를 둘 연달아 쓰지 않는다. XML 주석은 그
          연속을 허용하지 않아 매니페스트 병합 자체가 실패한다. 그래서 CSS 변수
          이름을 붙임표 없이 적었다.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          알림을 들고 있는 전경 서비스. `MEDIA_BUTTON` 필터가 있어야 이어폰·
          블루투스 버튼과 알림 버튼의 PendingIntent 가 이리로 온다.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
