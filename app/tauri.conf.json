{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "뮤피드",
  "version": "0.1.0",
  "identifier": "com.osundosun.mupid",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev:app",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix frontend run build:static",
    "frontendDist": "../frontend/dist/client"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "뮤피드",
        "width": 430,
        "height": 932,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: mupidimg: http://mupidimg.localhost https://mupidimg.localhost",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000",
        "style-src": "'self' 'unsafe-inline' http://localhost:3000",
        "font-src": "'self' data: http://localhost:3000",
        "img-src": "'self' data: blob: mupidimg: http://mupidimg.localhost https://mupidimg.localhost http://localhost:3000",
        "media-src": "'self' data: blob: http://localhost:3000",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
